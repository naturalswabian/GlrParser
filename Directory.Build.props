<Project>
  <PropertyGroup>

    <VersionPrefix>2.0.0</VersionPrefix>

    <!-- General -->
    <Authors>Jan B. Freuer</Authors>
    <Copyright>Copyright © 2026 Jan B. Freuer</Copyright>

    <!-- Compiler Settings -->
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS1591</NoWarn>

    <!-- Nuget Packaging -->
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/naturalswabian/GlrParser</PackageProjectUrl>
    <PackageOutputPath>$(SolutionDir)Sources/Packages/</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>NuGetGlrParser.png</PackageIcon>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)Resources\NuGetGlrParser.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
